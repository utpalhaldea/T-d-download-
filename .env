# ============================================================
# SERVER
# ============================================================

# Codespaces/Render/Railway jaise hosting par PORT automatically mil sakta hai.
# Local testing ke liye 3000 use kar sakte ho.
PORT=3000


# ============================================================
# TELEGRAM BOT
# ============================================================

# Telegram @BotFather se
BOT_TOKEN=


# https://my.telegram.org se
APP_ID=
API_HASH=


# Telegram storage supergroup ID
# Example:
# STORAGE_GROUP_ID=-1003843778132
STORAGE_GROUP_ID=


# Telegram admin user ID
ADMIN_ID=


# ============================================================
# FIREBASE
# ============================================================

# Firebase service-account JSON / configured secret
FIREBASE_SECRETS=


# ============================================================
# TERABOX
# ============================================================

COOKIES1=
COOKIES2=
COOKIES3=
COOKIES4=

THIRD_PARTY_TERABOXDL_URL=
PROXY_URL=


# ============================================================
# DISKWALA
# ============================================================

# DiskWala scraper proxy POST endpoint
DISKWALA_PROXY_URL=

# Keep this SECRET.
# Do NOT put this value in HTML or JavaScript.
DISKWALA_API_KEY=
